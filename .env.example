# Only these two keys are required for the default experiment.
LLM_API_KEY=
TYPESAFE_API_KEY=

# OpenAI-compatible Chat Completions endpoint; replace to test another provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=4096
# Leave empty to use provider defaults (some models reject temperature).
LLM_TEMPERATURE=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Published USD / million token rates, retrieved 2026-10-15.
# Change these when changing model/provider; cost is an estimate, not a bill.
LLM_INPUT_PRICE=0.75
LLM_CACHED_INPUT_PRICE=0.075
LLM_OUTPUT_PRICE=4.5
JEV_INPUT_PRICE=0.042
