# Keys are read from the environment; dmcall does not load this file itself.
# Copy it to .env and export the variables, or pass api_key= in code.

# Jev, the default decision model (https://console.typesafe.ai)
TYPESAFE_API_KEY=
# Optional: TYPESAFE_MODEL (default jev-1.13.0) and TYPESAFE_BASE_URL (default https://api.typesafe.ai)

# Generators: set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
