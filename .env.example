# APIM profile from the supplied gateway guide. One project key covers both providers.
API_GATEWAY=apim
APIM_BASE_URL=https://enhans-aoai-prod-apim.azure-api.net
APIM_SUBSCRIPTION_KEY=

# Generator protocol: responses or anthropic_messages through APIM.
# chat_completions is available only with API_GATEWAY=direct.
LLM_API_STYLE=responses
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=4096
LLM_TEMPERATURE=
TYPESAFE_MODEL=jev-1.13.0

# Direct-provider mode only. APIM ignores these keys and URLs.
LLM_API_KEY=
LLM_BASE_URL=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# USD / million tokens. Blank uses known defaults only for the pinned OpenAI model:
# input 0.75, cached input 0.075, output 4.50 (retrieved 2026-10-15).
# For other models, enter all applicable rates; unknown cost stays unavailable.
# These are reference rates, not the APIM project's invoice or surcharge.
LLM_INPUT_PRICE=
LLM_CACHED_INPUT_PRICE=
LLM_OUTPUT_PRICE=
LLM_CACHE_WRITE_5M_PRICE=
LLM_CACHE_WRITE_1H_PRICE=
JEV_INPUT_PRICE=0.042
