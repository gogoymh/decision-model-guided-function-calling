  {
   "name": "capital types are lowered only in schemas",
   "input": {
    "name": "plan",
    "description": "Pick a plan.",
    "parameters": {
     "type": "OBJECT",
     "properties": {
      "tier": {
       "type": "OBJECT",
       "enum": [
        {
         "type": "PREMIUM"
        },
        {
         "type": "BASIC"
        }
       ],
       "default": {
        "type": "PREMIUM"
       }
      },
      "kind": {
       "const": {
        "type": "FIXED"
       },
       "examples": [
        {
         "type": "SAMPLE"
        }
       ],
       "example": {
        "type": "ONE"
       }
      },
      "default": {
       "type": "STRING"
      },
      "enum": {
       "type": "ARRAY",
       "items": {
        "type": [
         "STRING",
         "NULL"
        ]
       }
      },
      "type": {
       "type": "INTEGER"
      },
      "nested": {
       "type": "OBJECT",
       "properties": {
        "const": {
         "type": "BOOLEAN"
        }
       },
       "additionalProperties": {
        "type": "NUMBER"
       }
      }
     },
     "$defs": {
      "examples": {
       "type": "STRING"
      }
     },
     "required": [
      "tier"
     ]
    }
   },
   "expected": {
    "name": "plan",
    "description": "Pick a plan.",
    "parameters": {
     "type": "object",
     "properties": {
      "tier": {
       "type": "object",
       "enum": [
        {
         "type": "PREMIUM"
        },
        {
         "type": "BASIC"
        }
       ],
       "default": {
        "type": "PREMIUM"
       }
      },
      "kind": {
       "const": {
        "type": "FIXED"
       },
       "examples": [
        {
         "type": "SAMPLE"
        }
       ],
       "example": {
        "type": "ONE"
       }
      },
      "default": {
       "type": "string"
      },
      "enum": {
       "type": "array",
       "items": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": {
       "type": "integer"
      },
      "nested": {
       "type": "object",
       "properties": {
        "const": {
         "type": "boolean"
        }
       },
       "additionalProperties": {
        "type": "number"
       }
      }
     },
     "$defs": {
      "examples": {
       "type": "string"
      }
     },
     "required": [
      "tier"
     ]
    }
   }
