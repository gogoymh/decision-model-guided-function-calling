{
 "note": "A tool definition in the OpenAI, Anthropic or Gemini format becomes {name, description, parameters}. Gemini's capital type names (OBJECT, STRING) are lower-cased wherever a schema is expected and nowhere else: the values of enum, const, default, example and examples are data, and the keys of properties, patternProperties, $defs, definitions and dependentSchemas are names. configuration_errors must be refused when the tool is defined or when a client is built with it, before any request.",
 "cases": [
  {
   "name": "openai chat completions",
   "input": {
    "type": "function",
    "function": {
     "name": "get_weather",
     "description": "Current weather for a city.",
     "parameters": {
      "type": "object",
      "properties": {
       "city": {
        "type": "string",
        "description": "City name."
       },
       "unit": {
        "type": "string",
        "enum": [
         "celsius",
         "fahrenheit"
        ],
        "default": "celsius"
       }
      },
      "required": [
       "city"
      ]
     }
    }
   },
   "expected": {
    "name": "get_weather",
    "description": "Current weather for a city.",
    "parameters": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string",
       "description": "City name."
      },
      "unit": {
       "type": "string",
       "enum": [
        "celsius",
        "fahrenheit"
       ],
       "default": "celsius"
      }
     },
     "required": [
      "city"
     ]
    }
   }
  },
